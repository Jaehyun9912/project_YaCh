{
  "type": "map",
  "value_type": "array",
  "comment": "NPC별로 부여할 수 있는 퀘스트 목록입니다. 키값은 NPC 이름입니다.",
  "default": {},
  "item_schema": {
    "type": "object",
    "comment": "단일 퀘스트 데이터",
    "default": {
      "id": { "type": "string", "comment": "퀘스트 고유 ID", "default": "" },
      "title": { "type": "string", "comment": "퀘스트 이름 (UI 표시용)", "default": "" },
      "description": { "type": "string", "comment": "퀘스트 전체 설명", "default": "" },
      "clear_NPC": { "type": "string", "comment": "완료 보고를 받을 NPC 이름", "default": "" },
      "accept_condition": {
        "type": "array",
        "comment": "수주 조건 목록 (포맷: tag:val>1, item:id>5, stat:str>10 등)",
        "item_schema": { "type": "string", "default": "" },
        "default": []
      },
      "process_condition": {
        "type": "map",
        "value_type": "string",
        "comment": "진행/달성 조건 (Key: 조건문, Value: 조건에 대한 설명)",
        "default": {}
      },
      "tokens": {
        "type": "array",
        "comment": "수주 시 즉시 획득 아이템/효과 (포맷: item:id+1, artifact:id, !map:name 등)",
        "item_schema": { "type": "string", "default": "" },
        "default": []
      },
      "submits": {
        "type": "map",
        "value_type": "string",
        "comment": "달성 시 제출(차감)할 아이템 (Key: 명령문(-), Value: 제출품 설명)",
        "default": {}
      },
      "rewards": {
        "type": "array",
        "comment": "완료 시 최종 획득 보상 (포맷: item:id+1, money:gold+100 등)",
        "item_schema": { "type": "string", "default": "" },
        "default": []
      }
    }
  }
}
